{
  "name": "governdiff-reviewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/sanitize-server-errors.mjs",
    "start": "vinext start",
    "preview": "node scripts/preview.mjs",
    "test": "npm run typecheck && npm run test:components && npm run build && node --test tests/rendered-html.test.mjs tests/performance.test.mjs && npm run test:browser",
    "test:components": "vitest run --config vitest.config.ts",
    "test:performance": "node scripts/benchmark-ui.mjs --strict",
    "test:browser": "node scripts/build-browser-fixtures.mjs && node scripts/browser-gate.mjs --strict",
    "test:reproducible": "node scripts/verify-reproducible-build.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "type": "module"
}
